# Copy to .env and fill in. Never commit .env - every secret is read from the environment.

# --- Core ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql://user:pass@host/db      (default: SQLite file in backend/data)
ADMIN_EMAIL=admin@demo.co.uk
ADMIN_PASSWORD=
AGENT_EMAIL=agent@demo.co.uk
AGENT_PASSWORD=

# --- LLM (free tier) ------------------------------------------------------
# groq (console.groq.com) | gemini (aistudio.google.com) | openrouter | mock (offline heuristics)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
# Optional: fine-tuned router served by finetune/serve.py
# CLASSIFIER_URL=http://localhost:8090/classify

# --- Behaviour --------------------------------------------------------------
REPLY_MODE=auto                 # auto = send immediately | review = hold every reply for approval
REFUND_AUTO_LIMIT_GBP=150
RAG_BACKEND=auto                # auto = fastembed + cross-encoder | lite = no ONNX models (low-memory hosts)

# --- Slack alerts (escalations + system errors) -----------------------------
SLACK_WEBHOOK_URL=

# --- Email channel + daily report (Gmail app password works) ----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
REPORT_RECIPIENTS=manager@example.com
REPORT_CRON_HOUR=8
# INBOUND_EMAIL_SECRET=          # if you use the /api/channels/email/inbound webhook instead of IMAP

# --- Telegram channel --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=true            # local dev; in production set a webhook + TELEGRAM_WEBHOOK_SECRET
TELEGRAM_WEBHOOK_SECRET=
